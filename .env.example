# Public template only: never put real credentials in this file.
# Copy to the Git-ignored root .env, then restrict access with chmod 600 .env.
# In production, supply secrets through your host's secret manager.
# Never prefix secrets with NEXT_PUBLIC_ or copy them into browser code/logs.

# Local PostgreSQL bootstrap settings. User/database names are configuration;
# POSTGRES_PASSWORD is secret. Choose a unique password before first startup.
POSTGRES_USER=dinopump
POSTGRES_PASSWORD=replace_with_a_unique_local_database_password
POSTGRES_DB=dinopump
POSTGRES_PORT=55432

# SECRET: the complete connection URL contains the database password.
# Use the same password as POSTGRES_PASSWORD; URL-encode reserved characters.
# Keep the host/port aligned with your database. Local Docker binds loopback only.
# These placeholders are not production credentials.
DATABASE_URL=postgresql://dinopump:replace_with_a_unique_local_database_password@127.0.0.1:55432/dinopump

# Server configuration below is not secret.
GAME_SERVER_PORT=3001
# Loopback-only worker health/readiness/metrics port; override in .env.commentary.
# COMMENTARY_HEALTH_PORT=3002
# Server-only web proxy target. Keep in sync with GAME_SERVER_PORT locally.
GAME_SERVER_ORIGIN=http://127.0.0.1:3001

# Exact browser origin for lobby mutations and WebSocket handshakes.
# Production: set NODE_ENV=production and an https:// same-site origin.
WEB_ORIGIN=http://127.0.0.1:3000

# No static session signing key is configured: the service generates random
# per-guest credentials, stores only their hashes, and sends HttpOnly cookies.
# Treat database contents, session cookies, and backups as private data.

# SECRET: put the separate worker URL ONLY in ignored .env.commentary,
# provisioned by pnpm db:worker-role. Do not add it to the main .env.
# Use the same database, a different username, and a unique URL-encoded password.
# Never use DATABASE_URL's privileged login here. Core gameplay needs no worker.
# COMMENTARY_DATABASE_URL=postgresql://dinopump_worker:replace_with_a_unique_worker_password@127.0.0.1:55432/dinopump
# Optional: put these ONLY in ignored .env.commentary. Omit to retain authored news.
# COMMENTARY_PROVIDER=openai
# OPENAI_API_KEY=replace_with_your_private_provider_key
# COMMENTARY_MODEL=your_pinned_responses_model_snapshot
# GitHub/cloud tokens and SSH private keys belong in their own credential stores,
# never in this committed template, screenshots, test fixtures, or logs.

# Hosted game: listen on 0.0.0.0; Render PORT takes priority over GAME_SERVER_PORT.
# GAME_SERVER_HOST=0.0.0.0
# DATABASE_SCHEMA=staging_<32-character-deployment-id>
# DATABASE_SSL_CA_FILE=/etc/secrets/supabase-ca.pem
# Supabase: use the session pooler on 5432. No SSL URL parameters; CA verification
# is explicit. Copy its routing username; game login is game_<id>.<project-ref>.
# Staging operator/runner configuration belongs in separate ignored files:
# see deploy/render.staging.yaml and docs/staging-deployment.md.
