# Local worker only. Copy to .env.commentary and chmod 600 that file.
# Same database/port as .env; a DIFFERENT login and unique encoded password.
# Provision once after migrations with pnpm db:worker-role.
COMMENTARY_DATABASE_URL=postgresql://dinopump_worker:replace_with_a_unique_worker_password@127.0.0.1:55432/dinopump
COMMENTARY_HEALTH_PORT=3002

# Optional; leave all three unset for complete authored news with no API calls.
# COMMENTARY_PROVIDER=openai
# OPENAI_API_KEY=replace_with_your_private_provider_key
# COMMENTARY_MODEL=your_pinned_responses_model_snapshot
# Never include the game/operator DATABASE_URL or browser NEXT_PUBLIC_* secrets.
# Hosted worker configuration is outside the approved two-service demo plan.
