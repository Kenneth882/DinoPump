{
  "name": "@dinopump/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "check": "node --env-file=../../.env --import tsx src/check.ts",
    "migrate": "node --env-file=../../.env --import tsx src/migrate.ts",
    "dev": "tsc -p tsconfig.json --watch",
    "provision-commentary": "node --env-file=../../.env --env-file=../../.env.commentary --import tsx src/provision-commentary.ts"
  },
  "dependencies": {
    "@dinopump/engine": "workspace:*",
    "@dinopump/contracts": "workspace:*",
    "@dinopump/game-content": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
